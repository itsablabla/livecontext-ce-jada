# LiveContext CE - compatibility env file for the BROWSER AGENT (agent_browse).
#
# The repository Docker Compose stack now enables the browser agent by default.
# This file is kept for compatibility and still pins WEBSEARCH_ENABLED=true.
# COMPOSE_PROFILES remains as a harmless legacy no-op with current compose files.
#
# Usage (from the repo root):
#   docker compose --env-file docker/.env.ce.browser-agent up -d
#
# Model: the agent node picks the model per AI provider. When the install is
# cloud-linked, the browser agent relays its LLM calls through your cloud
# connection (billed on the cloud account, like the other agents + web_search),
# so no local key is needed. Not linked? Add that provider's API key in the app
# (Settings > AI providers) or set the matching env key (e.g. GEMINI_API_KEY for
# Google), else the run fails with the provider's "No API key" error. Live
# screencast needs WEBSEARCH_CDP_JWT_SECRET on both services; without it the
# panel still shows the captured last-page screenshot.

COMPOSE_PROFILES=browser-agent
WEBSEARCH_ENABLED=true

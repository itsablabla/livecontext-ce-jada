# ══════════════════════════════════════════════════════════════════════
# LiveContext CE - Environment Configuration
# Copy this file: cp .env.ce.example .env
# ══════════════════════════════════════════════════════════════════════

# === LLM API Keys (at least one required) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Optional LLM Providers ===
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# === Social Login (leave empty to disable) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Credential Encryption (auto-generated if left empty) ===
# On first boot, LiveContext generates unique encryption keys and persists
# them to a Docker volume. You only need to set these if you want to
# provide your own keys (e.g., migrating from another instance).
# WARNING: Changing these after credentials have been stored will make
# existing encrypted credentials unreadable.
# CREDENTIAL_ENCRYPTION_PASSWORD=
# CREDENTIAL_ENCRYPTION_SALT=

# === Ports and remote access ===
# Both ports must be reachable from the machine you browse from: the web UI is on
# FRONTEND_PORT and the browser talks to the backend on BACKEND_PORT.
#
# These match docker/docker-compose-ce-monolith.yml, the DEV stack, whose defaults are
# deliberately off the common ports (18080 avoids colliding with a local gateway on 8080).
# The published compose at the repo root defaults to 3000/8080 instead, so if you are using
# that one, set these to 3000 and 8080.
FRONTEND_PORT=8870
BACKEND_PORT=18080
# NO TRAILING SLASH on either URL below: a trailing slash yields
# https://host//api/credentials/oauth2/callback for OAuth, which will not match the
# redirect URI you registered with the provider.
#
# PUBLIC_BASE_URL: where the BROWSER reaches the web UI. Consumed by OAUTH2_FRONTEND_URL,
# so a LAN install that leaves it empty sends OAuth users back to their own machine.
PUBLIC_BASE_URL=
# Browser-facing backend URL. Leave EMPTY and the app derives it from the address you
# opened it with, so serving CE on a LAN IP or a domain needs nothing else. Set it only
# when the backend is NOT at <the address you open the app with>:BACKEND_PORT, typically
# a reverse proxy serving everything on one origin:
#   GATEWAY_PUBLIC_URL=https://livecontext.example.com
GATEWAY_PUBLIC_URL=

# === Database (CHANGE before exposing the deployment beyond localhost) ===
POSTGRES_PASSWORD=postgres

# === Object Storage (MinIO - CHANGE BOTH before exposing beyond localhost) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# === LiveContext Cloud (optional) ===
# CE consumes the cloud marketplace in read/acquire mode out of the box
# (MARKETPLACE_MODE=remote). To accept signed cloud catalog/LLM bundles, set the
# public trusted key below; with none configured, CE safely rejects every bundle.
# CATALOG_BUNDLE_TRUSTED_KEYS=

# === Bridge (Claude Code CLI - optional) ===
# Uses your Claude subscription instead of API credits.
# Requires: Claude Code CLI installed + bridge running locally
#   cd mcp/bridge && node server.mjs
# BRIDGE_ENABLED=true
# BRIDGE_URL=http://host.docker.internal:8093

# === Update check (optional) ===
# Once a day this install asks the public release feed whether a newer version
# exists; that is what puts the "Update available" badge on Settings > Information.
# The request carries the running version and an anonymous install id (a random
# UUID stored in your own database, derived from nothing: no IP, no hostname, no
# account), so live self-hosted installs can be counted. See README-CE.md.
# Keep the update check but stay unidentified:
# CE_VERSIONCHECK_SENDINSTALLID=false
# Or drop the request entirely (no update badge either):
# CE_VERSIONCHECK_ENABLED=false

# === What's new panel (optional) ===
# After an upgrade, a one-time panel describes the newest change in the version you are
# running, with an image or a short clip. It ships inside the image, so it makes no network
# request and works offline; each user sees it once and older entries are never replayed.
# Remove it entirely (no panel, no sidebar entry):
# CHANGELOG_ENABLED=false

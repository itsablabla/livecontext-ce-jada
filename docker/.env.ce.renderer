# Compatibility env file for the interface-node PDF / screenshot renderer sidecar.
#
#   docker compose --env-file docker/.env.ce.renderer up -d
#
# The repository Docker Compose stack now enables the renderer by default. This
# file is kept for compatibility and still pins SCREENSHOT_RENDERER_URL explicitly.
# COMPOSE_PROFILES remains as a harmless legacy no-op with current compose files.
COMPOSE_PROFILES=renderer
SCREENSHOT_RENDERER_URL=http://screenshot-renderer:8094
